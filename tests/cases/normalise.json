{
  "behaviour": "normalise",
  "token_cases": [
    {"id": "case-upper", "input": "МАМА", "expected": "мама", "note": "Uppercase Cyrillic is casefolded."},
    {"id": "case-title", "input": "Котка", "expected": "котка", "note": "Sentence-initial capital is casefolded."},
    {"id": "punct-period", "input": "вкъщи.", "expected": "вкъщи", "note": "Trailing full stop is stripped."},
    {"id": "punct-comma", "input": "татко,", "expected": "татко", "note": "Trailing comma is stripped."},
    {"id": "punct-multi", "input": "Ура!?", "expected": "ура", "note": "Several punctuation marks are all stripped."},
    {"id": "punct-ellipsis-only", "input": "…", "expected": "", "note": "A token of only punctuation becomes empty (tokenise drops it)."},
    {"id": "quotes-guillemets", "input": "«Здравей»", "expected": "здравей", "note": "Guillemets are stripped."},
    {"id": "quotes-bg-low-high", "input": "„Добре“", "expected": "добре", "note": "Bulgarian low-high quotes are stripped."},
    {"id": "quotes-straight", "input": "\"Да\"", "expected": "да", "note": "Straight double quotes are stripped."},
    {"id": "dash-hyphen-minus-only", "input": "-", "expected": "", "note": "Hyphen-minus alone becomes empty."},
    {"id": "dash-en-only", "input": "–", "expected": "", "note": "En dash alone becomes empty."},
    {"id": "dash-em-only", "input": "—", "expected": "", "note": "Em dash alone becomes empty."},
    {"id": "dash-minus-sign-only", "input": "−", "expected": "", "note": "Minus sign (Unicode Sm, not P*) is also stripped."},
    {"id": "dash-nb-hyphen-only", "input": "‑", "expected": "", "note": "Non-breaking hyphen alone becomes empty."},
    {"id": "dash-inside-token-removed", "input": "ма-ма", "expected": "мама", "note": "normalise alone deletes an inner dash; splitting is tokenise's job."},
    {"id": "i-grave-precomposed", "input": "ѝ", "expected": "и", "note": "Precomposed ѝ maps to и."},
    {"id": "i-grave-uppercase", "input": "Ѝ", "expected": "и", "note": "Uppercase Ѝ maps to и."},
    {"id": "i-grave-decomposed", "input": "ѝ", "expected": "и", "note": "и plus combining grave maps to и."},
    {"id": "i-grave-with-comma", "input": "ѝ,", "expected": "и", "note": "ѝ with punctuation maps to и."},
    {"id": "stress-acute-decomposed", "input": "ма́ма", "expected": "мама", "note": "Combining acute stress mark is stripped."},
    {"id": "stress-acute-uppercase", "input": "МА́МА", "expected": "мама", "note": "Stress mark on uppercase is stripped and casefolded."},
    {"id": "stress-grave-precomposed-e", "input": "вѐче", "expected": "вече", "note": "Precomposed ѐ maps to е."},
    {"id": "stress-grave-decomposed-e", "input": "вѐче", "expected": "вече", "note": "е plus combining grave maps to е."},
    {"id": "short-i-kept", "input": "мой", "expected": "мой", "note": "й is a letter, not a stress mark: kept."},
    {"id": "short-i-decomposed", "input": "мой", "expected": "мой", "note": "и plus combining breve recomposes to й under NFC; breve is not stripped."},
    {"id": "hard-sign-with-stress", "input": "Пъ́т", "expected": "път", "note": "ъ kept, its stress mark stripped."},
    {"id": "soft-sign-kept", "input": "шофьор", "expected": "шофьор", "note": "ь kept."},
    {"id": "mixed-latin-lower-a", "input": "мaмa", "expected": "мама", "note": "Latin a inside a Cyrillic token maps to Cyrillic а."},
    {"id": "mixed-latin-lower-o", "input": "кoтка", "expected": "котка", "note": "Latin o inside a Cyrillic token maps to Cyrillic о."},
    {"id": "mixed-latin-lower-p", "input": "pак", "expected": "рак", "note": "Latin p inside a Cyrillic token maps to Cyrillic р."},
    {"id": "mixed-latin-upper-c", "input": "Cтол", "expected": "стол", "note": "Latin C inside a Cyrillic token maps to С, then casefolds."},
    {"id": "mixed-latin-upper-b", "input": "Bода", "expected": "вода", "note": "Latin uppercase B maps to В (case-sensitive table, applied before casefold)."},
    {"id": "pure-latin-upper", "input": "OK", "expected": "ok", "note": "A pure-Latin token stays Latin (casefolded only)."},
    {"id": "pure-latin-lower", "input": "taxi", "expected": "taxi", "note": "A pure-Latin token of look-alike letters is not mapped."},
    {"id": "pure-latin-with-punct", "input": "STOP!", "expected": "stop", "note": "Pure-Latin token: punctuation stripped, stays Latin."},
    {"id": "digit-kept", "input": "2", "expected": "2", "note": "Digits are kept for the digit lookup."},
    {"id": "digit-with-punct", "input": "10.", "expected": "10", "note": "Digits kept, punctuation stripped."},
    {"id": "empty-string", "input": "", "expected": "", "note": "Empty input stays empty."}
  ],
  "tokenise_cases": [
    {"id": "sentence-basic", "side": "text", "input": "Мама има котка.", "expected_tokens": ["мама", "има", "котка"], "expected_surface": ["Мама", "има", "котка."], "note": "Whitespace split; surface keeps case and attached punctuation."},
    {"id": "text-hyphen-joins-syllables", "side": "text", "input": "Ма-ма чете.", "expected_tokens": ["мама", "чете"], "expected_surface": ["Ма-ма", "чете."], "note": "Text side: a hyphen between letters joins the parts into one word (owner 2026-11-18)."},
    {"id": "text-nb-hyphen-joins-compound", "side": "text", "input": "по‑голям", "expected_tokens": ["поголям"], "expected_surface": ["по‑голям"], "note": "Text side: a non-breaking hyphen also joins."},
    {"id": "text-en-dash-splits", "side": "text", "input": "ба–ба", "expected_tokens": ["ба", "ба"], "expected_surface": ["ба", "ба"], "note": "Text side: an en dash is not a hyphen and splits."},
    {"id": "text-em-dash-splits", "side": "text", "input": "лято—море", "expected_tokens": ["лято", "море"], "expected_surface": ["лято", "море"], "note": "Text side: an em dash between words splits."},
    {"id": "heard-hyphen-minus-fragments", "side": "heard", "input": "ма-ма", "expected_tokens": ["ма", "ма"], "expected_surface": ["ма", "ма"], "note": "Heard side: hyphen-minus between letters splits into fragments."},
    {"id": "heard-en-dash-fragments", "side": "heard", "input": "ба–ба", "expected_tokens": ["ба", "ба"], "expected_surface": ["ба", "ба"], "note": "Heard side: en dash between letters splits."},
    {"id": "heard-em-dash-no-spaces", "side": "heard", "input": "лято—море", "expected_tokens": ["лято", "море"], "expected_surface": ["лято", "море"], "note": "Heard side: em dash between letters splits."},
    {"id": "heard-minus-sign-fragments", "side": "heard", "input": "ку−че", "expected_tokens": ["ку", "че"], "expected_surface": ["ку", "че"], "note": "Heard side: minus sign between letters splits."},
    {"id": "heard-nb-hyphen-compound", "side": "heard", "input": "по‑голям", "expected_tokens": ["по", "голям"], "expected_surface": ["по", "голям"], "note": "Heard side: non-breaking hyphen splits."},
    {"id": "heard-trailing-hyphen", "side": "heard", "input": "ма- ма", "expected_tokens": ["ма", "ма"], "expected_surface": ["ма", "ма"], "note": "Empty fragment after a trailing hyphen is dropped."},
    {"id": "heard-digit-article-suffix", "side": "heard", "input": "2-те котки", "expected_tokens": ["2те", "котки"], "expected_surface": ["2-те", "котки"], "note": "Heard side: digit + -те/-та stays one token for the digit lookup (owner 2026-11-18)."},
    {"id": "dialogue-dash-spaced", "side": "text", "input": "— Здравей! — каза Ани.", "expected_tokens": ["здравей", "каза", "ани"], "expected_surface": ["Здравей!", "каза", "Ани."], "note": "Standalone dialogue dashes are dropped from both lists."},
    {"id": "quotes-and-en-dash", "side": "text", "input": "„Кой е там?“ – пита Боби.", "expected_tokens": ["кой", "е", "там", "пита", "боби"], "expected_surface": ["„Кой", "е", "там?“", "пита", "Боби."], "note": "Quotes stay in surface, stripped from tokens; spaced en dash dropped."},
    {"id": "i-grave-in-sentence", "side": "text", "input": "Дадох ѝ ябълка.", "expected_tokens": ["дадох", "и", "ябълка"], "expected_surface": ["Дадох", "ѝ", "ябълка."], "note": "ѝ normalises to и; surface keeps ѝ."},
    {"id": "stress-in-sentence", "side": "heard", "input": "Ва́ня че́те.", "expected_tokens": ["ваня", "чете"], "expected_surface": ["Ва́ня", "че́те."], "note": "Stress marks stripped from tokens, kept in surface."},
    {"id": "mixed-and-pure-latin", "side": "text", "input": "Тук пише STOP и кaфе.", "expected_tokens": ["тук", "пише", "stop", "и", "кафе"], "expected_surface": ["Тук", "пише", "STOP", "и", "кaфе."], "note": "Pure-Latin STOP stays Latin; mixed к-a-фе maps to кафе."},
    {"id": "whitespace-variety", "side": "heard", "input": "Слънце\n  грее\tярко", "expected_tokens": ["слънце", "грее", "ярко"], "expected_surface": ["Слънце", "грее", "ярко"], "note": "Newline, tab and repeated spaces all split."},
    {"id": "nbsp-splits", "side": "text", "input": "мама има", "expected_tokens": ["мама", "има"], "expected_surface": ["мама", "има"], "note": "No-break space counts as whitespace."},
    {"id": "digit-in-sentence", "side": "heard", "input": "Имам 2 ябълки.", "expected_tokens": ["имам", "2", "ябълки"], "expected_surface": ["Имам", "2", "ябълки."], "note": "Digit token kept."},
    {"id": "punctuation-only-tokens-dropped", "side": "heard", "input": "Ах … ! Ох", "expected_tokens": ["ах", "ох"], "expected_surface": ["Ах", "Ох"], "note": "Tokens empty after normalising are dropped from both lists."},
    {"id": "empty-input", "side": "text", "input": "", "expected_tokens": [], "expected_surface": [], "note": "Empty text gives no tokens."},
    {"id": "whitespace-only", "side": "heard", "input": "  \n ", "expected_tokens": [], "expected_surface": [], "note": "Whitespace-only text gives no tokens."}
  ]
}
